# Quivo — shell app. Copy to .env.local. Never commit .env.local.
#
# ESSENTIAL (platform): auth, database, encryption, rate limits, OAuth app credentials.
# USER KEYS: Anthropic, Stripe billing, Tavily, etc. — each end user adds their own in the app UI.

# ── Auth (Clerk) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (Supabase) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Encrypt user vault + OAuth tokens (64 hex chars = 32 bytes) ──
# ENCRYPTION_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Rate limits (Upstash) — required on Vercel production ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google OAuth app (NOT user keys — your OAuth client for Connect Google) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Dropbox OAuth app (optional) ──
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ── Optional platform webhooks only (Quivo billing, not user Stripe) ──
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=

# OAUTH_STATE_SECRET=
# INTERNAL_SECURITY_LOG_SECRET=

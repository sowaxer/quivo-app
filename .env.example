# Copy to .env.local and fill in real values. Never commit .env.local.
# Create a free Redis database at https://upstash.com — REST URL + token for rate limits.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth for Gmail/Calendar/Drive integration
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match exactly (prod: set this to your Console URI):
# GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/google/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

TAVILY_API_KEY=

# Optional: Bearer for POST /api/internal/security-log (middleware → Supabase security_logs)
# INTERNAL_SECURITY_LOG_SECRET=

# User API key vault (AES-256-GCM). Use one of these (64 hex chars = 32 bytes):
# ENCRYPTION_SECRET=
# ENCRYPTION_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OAUTH_STATE_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
